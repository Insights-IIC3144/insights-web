{
  "name": "insights-web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "cypress:open": "CYPRESS_TESTING=true cypress open --env CYPRESS_TESTING=true --browser chrome",
    "cypress:run": "CYPRESS_TESTING=true cypress run --env CYPRESS_TESTING=true --browser chrome",
    "test:e2e": "CYPRESS_TESTING=true start-server-and-test dev http://localhost:3000 'cypress run --env CYPRESS_TESTING=true --browser chrome'",
    "test:e2e:electron": "CYPRESS_TESTING=true cypress run --env CYPRESS_TESTING=true",
    "test:e2e:sales": "CYPRESS_TESTING=true cypress run --env CYPRESS_TESTING=true --browser chrome --spec 'cypress/e2e/sales-dashboard.cy.ts'",
    "test:e2e:audiences": "CYPRESS_TESTING=true cypress run --env CYPRESS_TESTING=true --browser chrome --spec 'cypress/e2e/audiences-dashboard.cy.ts'",
    "test:e2e:executive": "CYPRESS_TESTING=true cypress run --env CYPRESS_TESTING=true --browser chrome --spec 'cypress/e2e/executive-dashboard.cy.ts'",
    "test:e2e:competitive": "CYPRESS_TESTING=true cypress run --env CYPRESS_TESTING=true --browser chrome --spec 'cypress/e2e/competitive-positioning.cy.ts'",
    "test:e2e:auth": "CYPRESS_TESTING=true cypress run --env CYPRESS_TESTING=true --browser chrome --spec 'cypress/e2e/auth.cy.ts'",
    "test:e2e:headed": "CYPRESS_TESTING=true cypress run --env CYPRESS_TESTING=true --browser chrome --headed --no-exit"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^3.5.0",
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "recharts": "^2.12.7",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cypress": "^15.15.0",
    "cypress-real-events": "^1.15.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
