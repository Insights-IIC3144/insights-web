{
  "presets": ["next/babel"],
  "plugins": [
    [
      "babel-plugin-istanbul",
      {
        "exclude": [
          "**/*.test.*",
          "**/*.spec.*",
          "cypress/**",
          "types/**",
          "public/**",
          "app/api/**",
          "app/layout.tsx",
          "app/login/page.tsx",
          "**/.gitkeep",
          "**/globals.css",
          "lib/mock.ts"
        ]
      }
    ]
  ]
}